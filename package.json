{
  "name": "batch-audio-studio-desktop",
  "version": "2.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on tcp:5173 && electron .\"",
    "dev:all": "npm run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:bridge-runtime": "node ./scripts/build-bridge-runtime.mjs",
    "build": "vite build",
    "dist": "npm run build && npm run build:bridge-runtime && electron-builder --mac dir",
    "dist:app": "npm run build && npm run build:bridge-runtime && electron-builder --mac zip"
  },
  "dependencies": {
    "framer-motion": "^11.3.19",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^4.1.2",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.cbi.batch-audio-studio.desktop",
    "productName": "Batch Audio Studio",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bridge",
        "to": "bridge",
        "filter": [
          "batch_audio_bridge.py",
          "batch_audio_backends.py",
          "batch_audio_core.py",
          "batch_audio_voice_registry.py",
          "config.py",
          "generation_controller.py",
          "studio_repository.py",
          "studio_session.py",
          "voice_clone_api.py",
          "audio_pipeline.py",
          "__init__.py"
        ]
      },
      {
        "from": ".tmp/bridge-runtime",
        "to": "bridge-runtime"
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dir"
      ]
    }
  }
}
