# Optional: local TTS endpoint (example for Qwen3-TTS web API)
# Leave empty to use mock mode by default.
# BATCH_AUDIO_LOCAL_API_BASE=http://127.0.0.1:42003

# Optional: remote Modal endpoint
BATCH_AUDIO_MODAL_API_BASE=

# Optional: where bridge state/database/runs are stored
# BATCH_AUDIO_CONFIG_DIR=~/.batch-audio-studio
# BATCH_AUDIO_OUTPUT_ROOT=~/.batch-audio-studio/runs

# Optional: saved local voice directory (if your local backend stores voices on disk)
# BATCH_AUDIO_LOCAL_VOICE_STORE=

# Optional: enable built-in mock mode when no backend is configured
BATCH_AUDIO_ENABLE_MOCK_TTS=true
